<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* <title>@ViewData["Title"] - DoDacPhamGia</title> *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DoDacPhamGia.styles.css" asp-append-version="true" />

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phạm Gia - Dịch vụ Thiết kế & Xây dựng Chuyên nghiệp</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <header class="fixed w-full z-50 bg-white shadow-md">
        <div class="container mx-auto px-6 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold text-xl mr-3">PG</div>
                    <a href="#" class="text-2xl font-bold text-gray-800">PHẠM <span class="text-amber-500">GIA</span></a>
                </div>

                <nav class="hidden md:flex items-center space-x-8">
                    <a href="#home" class="nav-link text-gray-800 hover:text-amber-500 transition">Trang chủ</a>
                    <a href="#services" class="nav-link text-gray-800 hover:text-amber-500 transition">Dịch vụ</a>
                    <a href="#projects" class="nav-link text-gray-800 hover:text-amber-500 transition">Dự án</a>
                    <a href="#about" class="nav-link text-gray-800 hover:text-amber-500 transition">Về chúng tôi</a>
                    <a href="#contact" class="nav-link text-gray-800 hover:text-amber-500 transition">Liên hệ</a>
                </nav>

                <div class="md:hidden">
                    <button id="menu-btn" class="text-gray-800 focus:outline-none">
                        <i class="fas fa-bars text-2xl"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Menu -->
            <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4">
                <a href="#home" class="block py-2 text-gray-800 hover:text-amber-500 transition">Trang chủ</a>
                <a href="#services" class="block py-2 text-gray-800 hover:text-amber-500 transition">Dịch vụ</a>
                <a href="#projects" class="block py-2 text-gray-800 hover:text-amber-500 transition">Dự án</a>
                <a href="#about" class="block py-2 text-gray-800 hover:text-amber-500 transition">Về chúng tôi</a>
                <a href="#contact" class="block py-2 text-gray-800 hover:text-amber-500 transition">Liên hệ</a>
            </div>
        </div>
    </header>
    <div class="">
            @RenderBody()
    </div>

    <!-- Map Section -->
    <div class="h-96 w-full">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3724.096866647462!2d105.78010841488348!3d21.02882078599851!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135ab86cece9ac1%3A0xa1e792a9e7e5c7e5!2zMTIzIFBo4buRIEFuIEQuLCBU4burIExpw6F1LCBIw6AgTuG7mWksIFZp4buHdCBOYW0!5e0!3m2!1svi!2s!4v1629981441217!5m2!1svi!2s" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
    </div>
    <!-- Footer -->
    <footer class="bg-gray-900 text-white py-12">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div>
                    <div class="flex items-center mb-4">
                        <div class="w-10 h-10 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold text-lg mr-3">PG</div>
                        <a href="#" class="text-xl font-bold">PHẠM <span class="text-amber-500">GIA</span></a>
                    </div>
                    <p class="text-gray-400 mb-4">Đơn vị thiết kế và xây dựng uy tín hàng đầu tại Việt Nam.</p>
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-400 hover:text-amber-500 transition"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="text-gray-400 hover:text-amber-500 transition"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-gray-400 hover:text-amber-500 transition"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="text-gray-400 hover:text-amber-500 transition"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>

                <div>
                    <h3 class="text-lg font-bold mb-4">Dịch vụ</h3>
                    <ul class="space-y-2">
                        <li><a href="#" class="text-gray-400 hover:text-amber-500 transition">Thiết kế kiến trúc</a></li>
                        <li><a href="#" class="text-gray-400 hover:text-amber-500 transition">Xây dựng công trình</a></li>
                        <li><a href="#" class="text-gray-400 hover:text-amber-500 transition">Giám sát thi công</a></li>
                        <li><a href="#" class="text-gray-400 hover:text-amber-500 transition">Thiết kế nội thất</a></li>
                        <li><a href="#" class="text-gray-400 hover:text-amber-500 transition">Cải tạo nhà ở</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-lg font-bold mb-4">Liên kết</h3>
                    <ul class="space-y-2">
                        <li><a href="#home" class="text-gray-400 hover:text-amber-500 transition">Trang chủ</a></li>
                        <li><a href="#services" class="text-gray-400 hover:text-amber-500 transition">Dịch vụ</a></li>
                        <li><a href="#projects" class="text-gray-400 hover:text-amber-500 transition">Dự án</a></li>
                        <li><a href="#about" class="text-gray-400 hover:text-amber-500 transition">Về chúng tôi</a></li>
                        <li><a href="#contact" class="text-gray-400 hover:text-amber-500 transition">Liên hệ</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-lg font-bold mb-4">Liên hệ</h3>
                    <ul class="space-y-2 text-gray-400">
                        <li class="flex items-start">
                            <i class="fas fa-map-marker-alt mt-1 mr-2 text-amber-500"></i>
                            <span>Số 123, đường ABC, quận XYZ, TP. Hà Nội</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-phone-alt mr-2 text-amber-500"></i>
                            <span>0243.123.4567</span>
                        </li>
                        <li class="flex items-center">
                            <i class="fas fa-envelope mr-2 text-amber-500"></i>
                            <span>info@phamgia.com</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="border-t border-gray-800 mt-12 pt-8 text-center text-gray-400">
                <p>&copy; 2023 Phạm Gia. Tất cả quyền được bảo lưu.</p>
            </div>
        </div>
    </footer>
    <!-- Back to Top Button -->
    <button id="back-to-top" class="fixed bottom-8 right-8 bg-amber-500 text-white p-3 rounded-full shadow-lg opacity-0 invisible transition-all duration-300">
        <i class="fas fa-arrow-up"></i>
    </button>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>